<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>WCP Claude Agent</title>
    <organization>com.penrithbeacon</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>

    <welcome    file="welcome.html"/>
    <license    file="license.html"/>
    <conclusion file="conclusion.html"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.penrithbeacon.claude-agent.pkg"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="com.penrithbeacon.claude-agent.pkg" visible="false">
        <pkg-ref id="com.penrithbeacon.claude-agent.pkg"/>
    </choice>

    <pkg-ref id="com.penrithbeacon.claude-agent.pkg"
             version="1.0.0"
             onConclusion="none">claude-agent.pkg</pkg-ref>
</installer-gui-script>
