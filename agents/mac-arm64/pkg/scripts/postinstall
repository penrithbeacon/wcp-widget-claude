#!/bin/bash
# ──────────────────────────────────────────────────────────────────────────────
# WCP Claude Agent — postinstall
# Launches the menu bar app and sets up auto-start on login.
# ──────────────────────────────────────────────────────────────────────────────

APP_PATH="/Applications/WCP Claude Agent.app"
PLIST_NAME="com.penrithbeacon.claude-agent"
LOG_DIR="$HOME/.penrith-beacon/claude-agent/logs"

# Resolve real user (pkg runs as root)
if [ "$EUID" -eq 0 ]; then
    CURRENT_USER=$(stat -f "%Su" /dev/console)
    USER_HOME=$(eval echo "~${CURRENT_USER}")
else
    CURRENT_USER="$USER"
    USER_HOME="$HOME"
fi

PLIST_PATH="${USER_HOME}/Library/LaunchAgents/${PLIST_NAME}.plist"

# Create log directory
mkdir -p "${USER_HOME}/.penrith-beacon/claude-agent/logs"
chown -R "$CURRENT_USER" "${USER_HOME}/.penrith-beacon"

# Create launchd plist for auto-start
mkdir -p "${USER_HOME}/Library/LaunchAgents"
cat > "$PLIST_PATH" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${APP_PATH}/Contents/MacOS/WCP Claude Agent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>${USER_HOME}/.penrith-beacon/claude-agent/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>${USER_HOME}/.penrith-beacon/claude-agent/logs/stderr.log</string>
</dict>
</plist>
EOF
chown "$CURRENT_USER" "$PLIST_PATH"

# Launch the app now
sudo -u "$CURRENT_USER" open "$APP_PATH"

exit 0
